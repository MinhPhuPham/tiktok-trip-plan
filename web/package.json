{
  "name": "tiktok-trip-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:data": "cd .. && uv run python web/scripts/dev_data.py",
    "build": "npm run typecheck && npm run build:app && npm run build:single",
    "build:app": "vite build --mode app",
    "build:single": "vite build --mode single",
    "preview": "vite preview --outDir ../src/tiktok_trip/export/web_dist/app",
    "gen:schema": "cd .. && uv run python -m tiktok_trip.export.schema web/src/data/trip.schema.json",
    "gen:types": "json2ts --input src/data/trip.schema.json --output src/data/trip.gen.ts --additionalProperties false --unreachableDefinitions --bannerComment \"/* Generated from trip.schema.json by npm run gen:types. Do not edit. */\"",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "maplibre-gl": "5.24.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  }
}
