      "required": [
        "src",
        "kind",
        "caption",
        "source_url",
        "attributions"
      ],
      "title": "MediaItem",
      "type": "object"
    },
    "OpeningPeriod": {
      "properties": {
        "day": {
          "description": "0=Monday ... 6=Sunday",
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "open": {
          "pattern": "^\\d{2}:\\d{2}$",
          "type": "string"
        },
        "close": {
          "anyOf": [
            {
              "pattern": "^\\d{2}:\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "day",
        "open",
        "close"
      ],
      "title": "OpeningPeriod",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "type": "integer"
    },
    "site_name": {
      "default": "TwLP-Trips",
      "type": "string"
    },
    "city": {
      "type": "string"
