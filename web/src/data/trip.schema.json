      "type": "object"
    },
    "MediaItem": {
      "description": "One preview image of a place in output/media/index.json; `src` is relative to output/.",
      "properties": {
        "src": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "frame",
            "photo"
          ],
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attributions": {
          "items": {
            "$ref": "#/$defs/MediaAttribution"
