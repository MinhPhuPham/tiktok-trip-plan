    "rings": {
      "items": {
        "$ref": "#/$defs/MapRing"
      },
      "type": "array"
    },
    "rays": {
      "items": {
        "$ref": "#/$defs/MapRay"
      },
      "type": "array"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/MapPlace"
      },
      "type": "array"
    },
    "nearby": {
      "items": {
        "$ref": "#/$defs/MapNearby"
      },
      "type": "array"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/MapDay"
      },
      "type": "array"
    },
    "day_colors": {
      "items": {
