      "required": [
        "id",
        "name",
        "category",
        "address",
        "lat",
        "lng",
        "sector",
        "color",
        "distance_km",
        "zone",
        "priority",
        "stars",
        "rating",
        "rating_count",
        "price",
        "must_try",
        "videos",
        "maps_url",
        "hours",
        "best",
        "best_source",
        "best_why",
        "best_time",
        "tags",
        "preference",
        "day",
        "stop"
      ],
      "title": "MapPlace",
      "type": "object"
    },
    "MapPlanConfig": {
      "description": "The plan rules the in-browser editor needs, serialised with camelCase keys.",
      "properties": {
        "dayStart": {
          "type": "string"
        },
        "dayEnd": {
          "type": "string"
        },
        "rhythm": {
          "items": {
            "$ref": "#/$defs/MapRhythmSlot"
          },
          "type": "array"
        },
        "serviceMinutes": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "nearbyServiceMinutes": {
          "type": "integer"
        },
        "restMinutes": {
          "type": "integer"
        },
        "restMinMinutes": {
          "type": "integer"
        },
        "restAtCenter": {
          "type": "boolean"
        },
        "targetPlacesPerDay": {
          "type": "integer"
        },
        "travelmode": {
          "type": "string"
        },
        "tripDays": {
          "type": "integer"
        },
        "maxPlacesPerDay": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxNearbyPerDay": {
          "type": "integer"
        },
        "dated": {
          "type": "boolean"
        }
      },
      "required": [
        "dayStart",
        "dayEnd",
        "rhythm",
        "serviceMinutes",
        "nearbyServiceMinutes",
        "restMinutes",
        "restMinMinutes",
        "restAtCenter",
        "targetPlacesPerDay",
        "travelmode",
        "tripDays",
        "maxPlacesPerDay",
        "maxNearbyPerDay",
        "dated"
      ],
      "title": "MapPlanConfig",
      "type": "object"
    },
    "MapPreferences": {
      "description": "input/preferences.yaml as read by the export; the map adds hidden places to `removed`.",
      "properties": {
        "must_go": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "removed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "must_go",
        "removed"
      ],
      "title": "MapPreferences",
      "type": "object"
    },
    "MapRay": {
      "properties": {
        "sector": {
