        "food": "#C95D52",
        "cafe": "#C59711",
        "attraction": "#0486F4",
        "other": "#9699B4"
      },
      "type": "object"
    },
    "category_ink": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {
        "food": "#000000",
        "cafe": "#000000",
        "attraction": "#000000",
        "other": "#000000"
      },
      "type": "object"
    },
    "center_color": {
      "type": "string"
