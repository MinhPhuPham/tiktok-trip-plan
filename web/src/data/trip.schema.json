{
  "$id": "https://tiktok-trip.local/trip.schema.json",
  "$defs": {
    "Basemap": {
      "properties": {
        "id": {
          "enum": [
            "google",
            "openfreemap",
            "esri_streets",
            "esri_satellite",
            "osm"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "default": "raster",
          "enum": [
            "raster",
            "vector"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "max_zoom": {
          "type": "integer"
        },
        "subdomains": {
          "default": "abc",
          "type": "string"
        },
        "labels_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retina": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "url",
        "attribution",
        "max_zoom",
        "subdomains",
        "labels_url",
        "retina"
      ],
      "title": "Basemap",
      "type": "object"
    },
    "GoogleBasemap": {
      "properties": {
        "name": {
          "default": "Google Maps",
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "src"
      ],
      "title": "GoogleBasemap",
      "type": "object"
    },
    "MapBestTime": {
      "properties": {
        "hours": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "days": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "months": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "hours",
        "days",
        "months",
        "deadline",
        "source"
      ],
      "title": "MapBestTime",
      "type": "object"
    },
    "MapCenter": {
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "source": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "maps_url": {
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lng",
        "kind",
        "name",
        "source",
        "maps_url"
      ],
      "title": "MapCenter",
      "type": "object"
    },
    "MapDay": {
      "properties": {
        "day": {
          "type": "integer"
        },
        "color": {
          "type": "string"
        },
        "areas": {
          "type": "string"
        },
        "span": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "directions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/MapStop"
          },
          "type": "array"
        }
      },
      "required": [
        "day",
        "color",
        "areas",
        "span",
        "directions",
        "stops"
      ],
      "title": "MapDay",
      "type": "object"
    },
    "MapHours": {
      "description": "Display text per language plus the raw periods the plan editor checks arrivals against.",
      "properties": {
        "en": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/OpeningPeriod"
          },
          "type": "array"
        }
      },
      "required": [
        "en",
        "vi",
        "periods"
      ],
      "title": "MapHours",
      "type": "object"
    },
    "MapLabels": {
      "description": "labels[lang] in trip.json: the map chrome (`ui`) plus the shared trip vocabulary.",
      "properties": {
        "ui": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "categories": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "directions": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "no_direction": {
          "type": "string"
        },
        "priorities": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "day": {
          "type": "string"
        },
        "best_time": {
          "type": "string"
        },
        "heuristic": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "directions_link": {
          "type": "string"
        },
        "leg": {
          "type": "string"
        },
        "no_plan": {
          "type": "string"
        },
        "twelve_hour": {
          "type": "boolean"
        },
        "day_units": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stop_kinds": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "tags": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "tags_title": {
          "type": "string"
        },
        "best_time_why": {
          "type": "string"
        },
        "kinds": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "unplaced_codes": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "ui",
        "categories",
        "directions",
        "no_direction",
        "priorities",
        "day",
        "best_time",
        "heuristic",
        "source",
        "directions_link",
        "leg",
        "no_plan",
        "twelve_hour",
        "day_units",
        "stop_kinds",
        "tags",
        "tags_title",
        "best_time_why",
        "kinds",
        "unplaced_codes"
      ],
      "title": "MapLabels",
      "type": "object"
    },
    "MapNearby": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "kind_label": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "rating": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "maps_url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "kind_label",
        "lat",
        "lng",
        "rating",
        "maps_url"
      ],
      "title": "MapNearby",
      "type": "object"
    },
    "MapPlace": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "sector": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "distance_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stars": {
          "type": "string"
        },
        "rating": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "rating_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "price": {
          "type": "string"
        },
        "must_try": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "videos": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maps_url": {
          "type": "string"
        },
        "hours": {
          "$ref": "#/$defs/MapHours"
        },
        "best": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "best_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "best_why": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "best_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapBestTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
