        "name_vi": {
          "type": "string"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "name_en",
        "name_vi",
        "categories"
      ],
      "title": "MapRhythmSlot",
      "type": "object"
    },
    "MapRing": {
      "properties": {
        "km": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": [
        "km",
        "label",
        "lat",
        "lng"
      ],
      "title": "MapRing",
      "type": "object"
    },
    "MapStop": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrive": {
          "type": "string"
        },
        "depart": {
          "type": "string"
        },
        "travel_min_to_next": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "activity": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "time": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "reason": {
          "type": "string"
        },
        "reason_vi": {
          "default": "",
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "maps_url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "slot",
        "arrive",
        "depart",
        "travel_min_to_next",
        "number",
        "name",
        "activity",
        "time",
        "reason",
        "reason_vi",
        "lat",
        "lng",
        "maps_url"
      ],
      "title": "MapStop",
      "type": "object"
    },
    "MapTravel": {
      "description": "data/plan/travel_minutes.csv: ids = \"center\", place ids, nearby ids; minutes[from][to].",
      "properties": {
        "ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "minutes": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "ids",
        "minutes"
